# Copie este archivo como .env para personalizar Docker Compose / ejecución local.
GATEWAY_API_KEY=frescoruta-demo-key
INTERNAL_TOKEN=cambie-este-token
LOG_LEVEL=INFO
# Probabilidad (0..1) de que la pasarela de pagos falle al iniciar
PAYMENT_FAILURE_RATE=0
# Opcional: usar PostgreSQL en lugar de SQLite (instale psycopg en requirements)
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/catalogo
